-- Draggable Feature
local dragging, dragInput, dragStart, startPos
mainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true; dragStart = input.Position; startPos = mainFrame.Position
		input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
	end
end)
mainFrame.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end end)
UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- ==========================================
-- DYNAMIC BUTTON CONTROL (Detects manual usage)
-- ==========================================
RunService.Heartbeat:Connect(function()
	if isExecuting then return end -- Let the script manage the button during execution

	local char = player.Character
	local hasBomb = player.Backpack:FindFirstChild("FakeBomb") or (char and char:FindFirstChild("FakeBomb"))

	if hasBomb then
		cooldown = false
		button.Text = "Jump [Q]"
		button.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
		btnStroke.Color = Color3.fromRGB(0, 170, 255)
	else
		cooldown = true
		button.Text = "Waiting for Bomb..."
		button.BackgroundColor3 = Color3.fromRGB(50, 20, 20)
		btnStroke.Color = Color3.fromRGB(255, 50, 50)
	end
end)

-- ==========================================
-- BOMB JUMP FUNCTION
-- ==========================================
local function DoBombJump()
	if cooldown or isExecuting then return end
	isExecuting = true -- Start execution

	-- Equip check
	if not EquipBomb() then
		isExecuting = false
		ShowErrorNotification("You don't have the Bomb. Please Purchase it.")
		return
	end

	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local bomb = char and char:FindFirstChild("FakeBomb")

	if not hrp or not humanoid or not bomb then 
		isExecuting = false
		return 
	end

	local snapshotHandles = {}
	for _, child in ipairs(Workspace:GetChildren()) do
		if child.Name == "Handle" then snapshotHandles[child] = true end
	end

	-- Update Button Visuals
	button.Text = "Jumping..."
	button.BackgroundColor3 = Color3.fromRGB(50, 20, 20)
	btnStroke.Color = Color3.fromRGB(255, 50, 50)

	-- Throw Bomb (0 delay)
	local lookDir = hrp.CFrame.LookVector
	local bombPos = hrp.Position + Vector3.new(lookDir.X * 1.5, -3, lookDir.Z * 1.5)
	bomb.Remote:FireServer(CFrame.new(bombPos), 50)

	-- Find our Handle
	local myHandle = nil
	local timeout = 2
	local elapsed = 0
	
	while elapsed < timeout do
		for _, child in ipairs(Workspace:GetChildren()) do
			if child.Name == "Handle" and not snapshotHandles[child] then
				myHandle = child
				break
			end
		end
		if myHandle then break end
		elapsed += task.wait() -- Instant wait
	end

	if myHandle then
		-- Execute Jump (0 delay, 62 Power)
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		task.wait(0)
		hrp.AssemblyLinearVelocity = Vector3.new(
			hrp.AssemblyLinearVelocity.X,
			62,
			hrp.AssemblyLinearVelocity.Z
		)

		-- Wait until the bomb is destroyed (Heartbeat will take over afterwards)
		while myHandle and myHandle.Parent do 
			task.wait(0.1) 
		end
	end

	isExecuting = false -- Hand control back to Dynamic Button Control
end

-- Bind Button and Key
button.MouseButton1Click:Connect(DoBombJump)
UserInputService.InputBegan:Connect(function(input, gpe)
	if not gpe and input.KeyCode == Enum.KeyCode.Q then
		DoBombJump()
	end
end)

print("Ruz Bomb Jump v4 (Flawless) Loaded!")
