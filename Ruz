-- ================================================================
--  Ruz Bomb Jump (Flawless & Auto-Controlled)
--  [Q] or Button to Bomb Jump
--  • Auto-equip: 0.01s (Ultra Fast)
--  • Jump Power: 62
--  • Delay: 0
--  • Auto bomb retriever every 2 seconds.
--  • Dynamic Cooldown: Button locks if the bomb is not in inventory.
-- ================================================================

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")
local UserInputService  = game:GetService("UserInputService")
local TweenService      = game:GetService("TweenService")
local RunService        = game:GetService("RunService")

local player  = Players.LocalPlayer
local cooldown = false
local isExecuting = false

-- ==========================================
-- AUTO BOMB RETRIEVER (EVERY 2 SECONDS)
-- ==========================================
task.spawn(function()
	while true do
		task.wait(2) -- Check every 2 seconds
		local char = player.Character
		local hasBomb = player.Backpack:FindFirstChild("FakeBomb") or (char and char:FindFirstChild("FakeBomb"))
		
		if not hasBomb then
			pcall(function()
				ReplicatedStorage.Remotes.Extras.ReplicateToy:InvokeServer("FakeBomb")
			end)
		end
	end
end)

-- ==========================================
-- ERROR NOTIFICATION
-- ==========================================
local function ShowErrorNotification(message)
	local screenGui = player.PlayerGui:FindFirstChild("RuzNotif") or Instance.new("ScreenGui", player.PlayerGui)
	screenGui.Name = "RuzNotif"
	
	local notifFrame = Instance.new("Frame", screenGui)
	notifFrame.Size = UDim2.new(0, 280, 0, 40)
	notifFrame.Position = UDim2.new(0.5, -140, 0.85, 0)
	notifFrame.BackgroundColor3 = Color3.fromRGB(20, 0, 0)
	notifFrame.BorderSizePixel = 0
	Instance.new("UICorner", notifFrame).CornerRadius = UDim.new(0, 8)
	
	local text = Instance.new("TextLabel", notifFrame)
	text.Size = UDim2.new(1, 0, 1, 0)
	text.BackgroundTransparency = 1
	text.Text = message
	text.TextColor3 = Color3.fromRGB(255, 80, 80)
	text.Font = Enum.Font.GothamBold
	text.TextSize = 12
	
	TweenService:Create(notifFrame, TweenInfo.new(0.3), {Position = UDim2.new(0.5, -140, 0.8, 0)}):Play()
	task.delay(2.5, function()
		local t = TweenService:Create(notifFrame, TweenInfo.new(0.5), {BackgroundTransparency = 1, Position = UDim2.new(0.5, -140, 0.85, 0)})
		TweenService:Create(text, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
		t:Play()
		t.Completed:Wait()
		notifFrame:Destroy()
	end)
end

-- ==========================================
-- FAST EQUIP (0.01s)
-- ==========================================
local function EquipBomb()
	local char = player.Character
	if not char then return false end
	if char:FindFirstChild("FakeBomb") then return true end
	
	local tool = player.Backpack:FindFirstChild("FakeBomb")
	if tool then
		char.Humanoid:EquipTool(tool)
		task.wait(0.01) -- Ultra fast equip speed
		return true
	end
	return false
end

